# Local Compose settings. Keep credentials and private keys outside Git.
COMPOSE_PROJECT_NAME=deployflow
API_PORT=8000
# Local development only. No incoming header can change this identity.
DF_ENVIRONMENT=local
DF_AUTH_MODE=development
DF_DEV_ACTOR_ID=local-developer
DF_DEV_ORGANIZATION_ID=local-organization
DF_DEV_ROLES=["developer"]
DF_CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
DF_FAKE_STEP_SECONDS=1
# Phase 2: configure these to analyze repositories through an installed GitHub App.
# Keep the PEM outside this repository and mount/read it by absolute path.
# Phase 3: deterministic remains the safe local default. Set agent only when
# you intentionally want selected repository excerpts analyzed by DeepSeek.
DF_ANALYSIS_MODE=deterministic
DF_DEEPSEEK_API_KEY=
DF_DEEPSEEK_BASE_URL=https://api.deepseek.com
DF_DEEPSEEK_MODEL=deepseek-flash
DF_DEEPSEEK_REASONING_EFFORT=high
# Phase 4 local-k3s preview profile. These are image names, not credentials.
GHCR_REGISTRY=ghcr.io
GHCR_IMAGE=ghcr.io/OWNER/APPLICATION
DF_NODE_BASE_IMAGE=node:20-bookworm-slim
# Phase 5 is opt-in. Keep every referenced key/token/CA file outside Git.
DF_KUBE_READER_MCP_URL=
DF_KUBE_VALIDATOR_MCP_URL=
DF_K3S_SSH_TARGET=
DF_K3S_SSH_KEY_PATH=
DF_K3S_KNOWN_HOSTS_PATH=
DF_KUBE_CA_PATH=
DF_KUBE_READER_TOKEN_PATH=
DF_KUBE_VALIDATOR_TOKEN_PATH=
DF_KUBE_DEPLOYER_TOKEN_PATH=
DF_KUBE_CLEANER_TOKEN_PATH=
# Phase 7 execution is opt-in and requires a configured OIDC provider.
# For the loopback-only Keycloak development profile, see README. Keep the
# password file outside the repository and set its absolute path here.
DF_LOCAL_OIDC_ENV_FILE=
DF_DEPLOYMENT_EXECUTION_ENABLED=false
DF_DEPLOYMENT_CLEANUP_ENABLED=false
DF_OIDC_ISSUER=
DF_OIDC_AUDIENCE=
DF_OIDC_JWKS_URL=
DF_OIDC_AUTHORIZATION_ENDPOINT=
DF_OIDC_TOKEN_ENDPOINT=
DF_OIDC_CLIENT_ID=
# One execution claim lasts 300 seconds; the whole rollout has a 600-second deadline.
DF_EXECUTION_LEASE_SECONDS=300
DF_EXECUTION_DEADLINE_SECONDS=600
DF_EXECUTION_RETRY_SECONDS=15
DF_EXECUTION_MAX_ATTEMPTS=5
# Legacy Phase 2 compatibility only: fake maps to fake, github maps to deterministic.
DF_ANALYSIS_PROVIDER=
DF_GITHUB_APP_ID=
DF_GITHUB_INSTALLATION_ID=
DF_GITHUB_PRIVATE_KEY_PATH=
# Phase 6: configure the same high-entropy value in the GitHub App webhook settings.
# The local API must be reachable from GitHub over HTTPS for live delivery.
DF_GITHUB_WEBHOOK_SECRET=
WEBHOOK_PORT=8002
# Delivery worker retry settings. Start its Compose profile only after the
# existing validator profile and GitHub App access are configured.
DF_DELIVERY_MAX_ATTEMPTS=5
DF_DELIVERY_LEASE_SECONDS=300
DF_DELIVERY_RETRY_SECONDS=30

# Optional immutable local backend image selection (activation requires review).
DF_BACKEND_IMAGE=deployflow-backend:local
# The tunnel supervisor reconnects SSH without replacing its network namespace.
DF_K3S_TUNNEL_IMAGE=deployflow-k3s-tunnel:local
