FROM ghcr.io/astral-sh/uv:0.10.9 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /srv/backend
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/srv/backend/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
# The public checker image contains only its HTTP module, not the backend API,
# credential bootstrap, repository integrations, tests, or operational records.
COPY --chown=10001:10001 app/incluster_health.py ./app/incluster_health.py
RUN useradd --uid 10001 --create-home deployflow
USER 10001:10001
CMD ["uvicorn", "app.incluster_health:app", "--host", "0.0.0.0", "--port", "8080"]
